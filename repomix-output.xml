    if (msg['msglist'].isEmpty) {
      print("Please type a message first!");
      return;
    }

    // 3. Print or pass it to your backend API / AI processing logic
    print("Packaged Message Method: ${msg['method']}");
    print("Packaged Message Strings: ${msg['msglist']}");
